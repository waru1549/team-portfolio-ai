
# =========================================
# TEAM PORTFOLIO AI - FRONTEND ENVIRONMENT
# =========================================

# -----------------------------------------
# LOCAL DEVELOPMENT
# -----------------------------------------

# Express Backend URL for Vite Proxy
API_PROXY_TARGET=http://localhost:3000

# Leave empty to use Vite Proxy in development
VITE_API_BASE_URL=


# -----------------------------------------
# PRODUCTION
# -----------------------------------------

# Set this variable in your deployment platform
# Example:
# VITE_API_BASE_URL=https://your-backend.example.com
#
# Do not put API secrets in VITE_ variables.
